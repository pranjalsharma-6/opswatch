# Supabase --------------------------------------------------------------------
# Project URL and anon key from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service-role key, also from Project Settings → API.
# Server-only: it bypasses row level security, so it must never be prefixed
# with NEXT_PUBLIC_ or referenced from a client component.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Groq ------------------------------------------------------------------------
# Free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: pin a specific model. Leave unset to use the built-in fallback
# chain. See https://console.groq.com/docs/models for current model ids.
# GROQ_MODEL=llama-3.3-70b-versatile
